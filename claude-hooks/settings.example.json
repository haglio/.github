{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "bash \"$HOME/.claude/hooks/git-rebase-guard.sh\"", "timeout": 10, "statusMessage": "git-rebase-guard"}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "bash \"$HOME/.claude/hooks/wip-checkpoint.sh\"", "timeout": 30, "statusMessage": "wip-checkpoint"}
        ]
      }
    ]
  }
}
